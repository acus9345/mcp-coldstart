{
  "name": "mcp-coldstart",
  "version": "0.1.0",
  "description": "Measure an MCP server's cold start (spawn → initialize → tools/list), memory and tool-definition size, and fail CI when they regress.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "benchmark",
    "performance",
    "cold-start",
    "startup-time",
    "latency",
    "regression",
    "ci",
    "stdio",
    "cli"
  ],
  "author": "acus9345",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mcp-coldstart": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck && node --check examples/demo-server.mjs && node --check test/fixtures/sdk-server.mjs && node --check test/fixtures/echo-args.mjs && node --check scripts/run-tests.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^18.19.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
